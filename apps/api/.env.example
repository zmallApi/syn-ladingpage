# Synapsee API — Fase 1 + MCP + Business tools
PLATFORM_API_KEY=dev-key
ENCRYPTION_KEY=dev-encryption-key-change-me
# JWT for Admin email/password sessions (defaults to ENCRYPTION_KEY)
JWT_SECRET=dev-jwt-secret-change-me
# Requests per minute per user/key (Admin polls often; default 600)
RATE_LIMIT_MAX=600
PORT=3000
LOG_LEVEL=info
# Relative to apps/api when running via npm workspace
DATA_DIR=../../data
# URL pública usada em /p/:id/mcp.json (config Cursor / Claude)
PUBLIC_API_URL=http://localhost:3000
# Opcional: Knowledge Builder / refino via LLM (sem enviar rows)
# LLM_PROVIDER=openai|anthropic|gemini|openai_compatible
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OpenAI-compatible (Ollama/vLLM): OPENAI_BASE_URL=http://localhost:11434/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
