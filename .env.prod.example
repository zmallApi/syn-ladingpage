# Copie para .env.prod na VPS e preencha valores reais.
#   cp .env.prod.example .env.prod

# --- Secrets (obrigatório trocar) ---
PLATFORM_API_KEY=troque-esta-chave-ops
ENCRYPTION_KEY=troque-esta-chave-32chars-minimo
JWT_SECRET=troque-este-jwt-secret

# URL pública da API (bakeada no Admin + snippets MCP)
# Produção com DNS: https://api.synapsee.tec.br
# Dev/IP direto:    http://SEU_IP:3100
PUBLIC_API_URL=https://api.synapsee.tec.br

# Portas no host — escolha livres na VPS (não colidir com pfit / outros)
# Ocupadas tipicamente pelo pfit:
#   4000 api · 4100 importador · 8080 bff · 5432 postgres
#   3010 auth · 3001 estudio · 3020 whatsapp (localhost)
# Synapsee defaults (livres nesse layout):
API_HOST_PORT=3100
ADMIN_HOST_PORT=8180

LOG_LEVEL=info
RATE_LIMIT_MAX=600

# LLM opcional no servidor (projetos ainda podem ter key própria)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
